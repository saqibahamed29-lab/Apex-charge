<section class="section section--dark why-apex-v2" id="why-apex">
  <div class="wrap why-apex-v2__grid">
    <div class="why-apex-v2__copy" data-animate>
      <span class="mono-tag why-apex-v2__tag">Spec 01 &mdash; Formula</span>
      <h2 class="h-display why-apex-v2__heading">{{ section.settings.heading }}</h2>
      <div class="why-apex-v2__body">{{ section.settings.body }}</div>
      <div class="why-apex-v2__cta">
        <a href="{{ section.settings.cta_url | default: '#the-research' }}" class="btn btn--outline">
          {{ section.settings.cta_label }}
          {% render 'icon', name: 'chevron-right' %}
        </a>
      </div>
    </div>

    <div class="spec-list" data-animate-group>
      {%- for block in section.blocks -%}
        <div class="spec-list__row" data-animate {{ block.shopify_attributes }}>
          <span class="spec-list__value">{{ block.settings.value }}</span>
          <span class="spec-list__line" aria-hidden="true"></span>
          <span class="spec-list__label">{{ block.settings.label }}</span>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Why Apex",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "We didn't build another energy drink. We built a formula."
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Body copy",
      "default": "<p>Every ingredient is selected for a reason and dosed on purpose &mdash; not hidden inside a proprietary blend.</p>"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "CTA label",
      "default": "See the Research"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "CTA link"
    }
  ],
  "blocks": [
    {
      "type": "ingredient",
      "name": "Formula item",
      "settings": [
        { "type": "text", "id": "value", "label": "Amount", "info": "Only use amounts that are on the real supplement facts panel." },
        { "type": "text", "id": "label", "label": "Label" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Why Apex",
      "blocks": [
        { "type": "ingredient", "settings": { "value": "200mg", "label": "Caffeine" } },
        { "type": "ingredient", "settings": { "value": "100mg", "label": "L-Theanine" } },
        { "type": "ingredient", "settings": { "value": "1,000mg", "label": "Taurine" } },
        { "type": "ingredient", "settings": { "value": "6", "label": "B Vitamins" } },
        { "type": "ingredient", "settings": { "value": "3", "label": "Electrolytes" } }
      ]
    }
  ]
}
{% endschema %}
