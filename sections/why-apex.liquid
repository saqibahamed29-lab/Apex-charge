<section class="section section--white" id="why-apex">
  <div class="wrap why-apex__grid">
    <div class="why-apex__copy" data-animate>
      <span class="eyebrow">Why Apex?</span>
      <h2 class="h-section">{{ section.settings.heading }}</h2>
      <div style="margin-top: 20px;">
        {{ section.settings.body }}
      </div>
      <div class="why-apex__cta">
        <a href="{{ section.settings.cta_url | default: '#the-research' }}" class="btn btn--ghost">
          {{ section.settings.cta_label }}
          {% render 'icon', name: 'chevron-right' %}
        </a>
      </div>
    </div>

    <div class="formula-grid" data-animate style="transition-delay: 100ms;">
      {%- for block in section.blocks -%}
        <div class="formula-item" {{ block.shopify_attributes }}>
          <div class="formula-item__value">{{ block.settings.value }}</div>
          <div class="formula-item__label">{{ block.settings.label }}</div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Why Apex",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "We focused on the formula."
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Body copy",
      "default": "<p>We didn't want to make another energy drink.</p><p>We wanted to build an energy formula around energy + focus, with ingredients selected for a reason and amounts clearly disclosed.</p>"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "CTA label",
      "default": "See the Research"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "CTA link"
    }
  ],
  "blocks": [
    {
      "type": "ingredient",
      "name": "Formula item",
      "settings": [
        { "type": "text", "id": "value", "label": "Amount", "info": "Only use amounts that are on the real supplement facts panel." },
        { "type": "text", "id": "label", "label": "Label" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Why Apex",
      "blocks": [
        { "type": "ingredient", "settings": { "value": "200mg", "label": "Caffeine" } },
        { "type": "ingredient", "settings": { "value": "100mg", "label": "L-Theanine" } },
        { "type": "ingredient", "settings": { "value": "1000mg", "label": "Taurine" } },
        { "type": "ingredient", "settings": { "value": "6", "label": "B Vitamins" } },
        { "type": "ingredient", "settings": { "value": "3", "label": "Electrolytes" } }
      ]
    }
  ]
}
{% endschema %}
