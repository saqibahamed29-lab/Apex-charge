<section class="hero" id="top">
  <div class="hero__inner">
    <div class="hero__content-col">
      <div class="hero__content" data-animate>
      <span class="hero__ribbon">{{ section.settings.eyebrow }}</span>

      <h1 class="hero__title">
        <span class="hero__title-line hero__title-line--ink">{{ section.settings.heading_line1 }}</span>
        <span class="hero__title-line hero__title-line--accent">{{ section.settings.heading_line2 }}</span>
        <span class="hero__title-line hero__title-line--accent">{{ section.settings.heading_line3 }}</span>
      </h1>

      <p class="hero__lede">{{ section.settings.lede }}</p>

      {%- if section.blocks.size > 0 -%}
        <ul class="hero__features" data-animate-group>
          {%- for block in section.blocks -%}
            {%- if block.type == 'feature' -%}
              <li class="hero__feature" data-animate {{ block.shopify_attributes }}>
                <span class="hero__feature-icon">{% render 'icon', name: block.settings.icon %}</span>
                <span class="hero__feature-copy">
                  <span class="hero__feature-title">{{ block.settings.title }}</span>
                  <span class="hero__feature-text">{{ block.settings.text }}</span>
                </span>
              </li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      {%- endif -%}

      <div class="hero__ctas">
        <a href="{{ section.settings.primary_cta_url | default: '#purchase-apex' }}" class="btn btn--gold">{{ section.settings.primary_cta_label }}</a>
        <a href="{{ section.settings.secondary_cta_url | default: '#comparison' }}" class="btn btn--outline-navy">{{ section.settings.secondary_cta_label }}</a>
      </div>

      {%- if section.blocks.size > 0 -%}
        <div class="hero__trust">
          {%- for block in section.blocks -%}
            {%- if block.type == 'trust_item' -%}
              <div class="hero__trust-item" {{ block.shopify_attributes }}>
                <span class="hero__trust-icon">{% render 'icon', name: block.settings.icon %}</span>
                <span class="hero__trust-label">{{ block.settings.label }}</span>
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
    </div>

    <div class="hero__visual" data-animate style="transition-delay: 120ms;">
      <div class="hero__visual-frame">
        {%- if section.settings.product_image != blank -%}
          {{ section.settings.product_image | image_url: width: 1600 | image_tag: loading: 'eager', fetchpriority: 'high', alt: section.settings.product_image.alt | default: 'Apex Energy Powder — Strawberry Shortcake, on a marble counter with fresh strawberries and white flowers' }}
        {%- else -%}
          <img src="{{ 'apex-product-lifestyle.png' | asset_url }}" alt="Apex Energy Powder — Strawberry Shortcake, on a marble counter with fresh strawberries and white flowers" width="1536" height="1024" loading="eager" fetchpriority="high">
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Ribbon badge",
      "default": "Fuel · Focus · Performance"
    },
    {
      "type": "text",
      "id": "heading_line1",
      "label": "Heading line 1 (ink)",
      "default": "Energy + Focus,"
    },
    {
      "type": "text",
      "id": "heading_line2",
      "label": "Heading line 2 (accent)",
      "default": "Formulated"
    },
    {
      "type": "text",
      "id": "heading_line3",
      "label": "Heading line 3 (accent)",
      "default": "Differently."
    },
    {
      "type": "textarea",
      "id": "lede",
      "label": "Supporting line",
      "default": "Clean ingredients. Transparent formula. Real results."
    },
    {
      "type": "image_picker",
      "id": "product_image",
      "label": "Product image",
      "info": "Defaults to the Apex Energy Powder lifestyle photo."
    },
    {
      "type": "text",
      "id": "primary_cta_label",
      "label": "Primary button label",
      "default": "Shop Apex"
    },
    {
      "type": "url",
      "id": "primary_cta_url",
      "label": "Primary button link"
    },
    {
      "type": "text",
      "id": "secondary_cta_label",
      "label": "Secondary button label",
      "default": "Compare"
    },
    {
      "type": "url",
      "id": "secondary_cta_url",
      "label": "Secondary button link"
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature row",
      "limit": 3,
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "bolt", "label": "Bolt" },
            { "value": "droplet", "label": "Droplet" },
            { "value": "flask", "label": "Flask" },
            { "value": "leaf", "label": "Leaf" },
            { "value": "check-shield", "label": "Shield check" },
            { "value": "microscope", "label": "Microscope" }
          ],
          "default": "bolt"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Supports Energy & Focus*"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Supporting text",
          "default": "Powered by research-backed ingredients."
        }
      ]
    },
    {
      "type": "trust_item",
      "name": "Trust bar item",
      "limit": 3,
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "check-shield", "label": "Shield check" },
            { "value": "microscope", "label": "Microscope" },
            { "value": "leaf", "label": "Leaf" },
            { "value": "droplet", "label": "Droplet" },
            { "value": "flask", "label": "Flask" },
            { "value": "bolt", "label": "Bolt" }
          ],
          "default": "check-shield"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Transparent Formula"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hero",
      "blocks": [
        { "type": "feature", "settings": { "icon": "bolt", "title": "Supports Energy & Focus*", "text": "Powered by research-backed ingredients." } },
        { "type": "feature", "settings": { "icon": "droplet", "title": "Maintains Electrolyte Balance*", "text": "Stay hydrated. Stay sharp." } },
        { "type": "feature", "settings": { "icon": "flask", "title": "Transparent Formula", "text": "No hidden blends. No proprietary formulas." } },
        { "type": "trust_item", "settings": { "icon": "check-shield", "label": "Transparent Formula" } },
        { "type": "trust_item", "settings": { "icon": "microscope", "label": "Research Linked" } },
        { "type": "trust_item", "settings": { "icon": "leaf", "label": "Clean & Disclosed" } }
      ]
    }
  ]
}
{% endschema %}
