<section class="hero" id="top">
  <div class="hero__glow" aria-hidden="true"></div>
  <div class="wrap hero__inner">
    <div class="hero__content" data-animate>
      {%- if section.settings.kicker != blank -%}
        <span class="hero__kicker">{{ section.settings.kicker }}</span>
      {%- endif -%}
      <h1 class="hero__title">
        {%- if section.settings.heading_line1 != blank -%}<span class="hero__title-line">{{ section.settings.heading_line1 }}</span>{%- endif -%}
        {%- if section.settings.heading_line2 != blank -%}<span class="hero__title-line{% if section.settings.heading_line3 == blank %} hero__title-line--accent{% endif %}">{{ section.settings.heading_line2 }}</span>{%- endif -%}
        {%- if section.settings.heading_line3 != blank -%}<span class="hero__title-line hero__title-line--accent">{{ section.settings.heading_line3 }}</span>{%- endif -%}
      </h1>

      <p class="hero__lede">{{ section.settings.lede }}</p>

      {%- if section.blocks.size > 0 -%}
        <ul class="hero__benefits" data-animate-group>
          {%- for block in section.blocks -%}
            {%- if block.type == 'benefit' -%}
              <li class="hero__benefit" data-animate {{ block.shopify_attributes }}>
                <span class="hero__benefit-icon">{% render 'icon', name: block.settings.icon %}</span>
                <span class="hero__benefit-label">{{ block.settings.label }}</span>
              </li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      {%- endif -%}

      <div class="hero__ctas">
        <a href="{{ section.settings.primary_cta_url | default: '#purchase-apex' }}" class="btn btn--lime">
          {{ section.settings.primary_cta_label }} {% render 'icon', name: 'bolt' %}
        </a>
      </div>
      <p class="hero__shipping-note">{{ section.settings.shipping_note }}</p>
    </div>

    <div class="hero__visual" data-animate style="transition-delay: 120ms;">
      <div class="hero__visual-glow" aria-hidden="true"></div>
      <div class="hero__visual-bolt" aria-hidden="true">{% render 'icon', name: 'bolt' %}</div>
      <div class="hero__visual-frame">
        {%- if section.settings.product_image != blank -%}
          {{ section.settings.product_image | image_url: width: 1200 | image_tag: loading: 'eager', fetchpriority: 'high', alt: section.settings.product_image.alt | default: 'Apex Energy Powder — Strawberry Shortcake' }}
        {%- else -%}
          <img src="{{ 'apex-product-lifestyle.png' | asset_url }}" alt="Apex Energy Powder — Strawberry Shortcake" width="1536" height="1024" loading="eager" fetchpriority="high">
        {%- endif -%}
      </div>

      {%- if section.blocks.size > 0 -%}
        <div class="hero__stats" data-animate-group>
          {%- for block in section.blocks -%}
            {%- if block.type == 'stat' -%}
              <div class="hero__stat hero__stat--{{ forloop.index0 }}" data-animate {{ block.shopify_attributes }}>
                <span class="hero__stat-dot" aria-hidden="true"></span>
                <span class="hero__stat-line" aria-hidden="true"></span>
                <span class="hero__stat-text">
                  <span class="hero__stat-value">{{ block.settings.value }}</span>
                  <span class="hero__stat-label">{{ block.settings.label }}</span>
                </span>
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "For the moments that matter"
    },
    {
      "type": "text",
      "id": "heading_line1",
      "label": "Heading line 1",
      "default": "Built For The"
    },
    {
      "type": "text",
      "id": "heading_line2",
      "label": "Heading line 2 (accent if line 3 is blank)",
      "default": "Flow State."
    },
    {
      "type": "text",
      "id": "heading_line3",
      "label": "Heading line 3 (accent, optional)",
      "default": ""
    },
    {
      "type": "textarea",
      "id": "lede",
      "label": "Supporting line",
      "default": "High energy. Deep focus. Smooth, sustained energy. A purposeful energy formula with 200mg caffeine, 100mg L-theanine and 1,000mg taurine — designed to help you feel energized, focused and ready to lock in."
    },
    {
      "type": "image_picker",
      "id": "product_image",
      "label": "Product image",
      "info": "Defaults to the Apex Energy Powder lifestyle photo."
    },
    {
      "type": "text",
      "id": "primary_cta_label",
      "label": "Primary button label",
      "default": "Get Into Flow"
    },
    {
      "type": "url",
      "id": "primary_cta_url",
      "label": "Primary button link"
    },
    {
      "type": "text",
      "id": "shipping_note",
      "label": "Note below CTA",
      "default": "20 Servings · Strawberry Shortcake"
    }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit indicator",
      "limit": 3,
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "bolt", "label": "Bolt" },
            { "value": "brain", "label": "Brain" },
            { "value": "droplet", "label": "Droplet" },
            { "value": "check-shield", "label": "Shield check" }
          ],
          "default": "bolt"
        },
        { "type": "text", "id": "label", "label": "Label", "default": "Clean Energy" }
      ]
    },
    {
      "type": "stat",
      "name": "Floating stat",
      "limit": 4,
      "settings": [
        { "type": "text", "id": "value", "label": "Value", "default": "200mg" },
        { "type": "text", "id": "label", "label": "Label", "default": "Clean Caffeine" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hero",
      "blocks": [
        { "type": "stat", "settings": { "value": "200mg", "label": "Caffeine" } },
        { "type": "stat", "settings": { "value": "100mg", "label": "L-Theanine" } },
        { "type": "stat", "settings": { "value": "1,000mg", "label": "Taurine" } },
        { "type": "stat", "settings": { "value": "0g", "label": "Sugar" } }
      ]
    }
  ]
}
{% endschema %}
