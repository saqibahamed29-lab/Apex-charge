<header class="site-header" data-header>
  <div class="wrap site-header__inner">
    <button class="icon-btn nav-toggle" type="button" data-nav-open aria-label="Open menu" aria-expanded="false" aria-controls="MobileNav">
      {% render 'icon', name: 'menu' %}
    </button>

    <a href="{{ routes.root_url }}" class="site-header__logo" aria-label="{{ shop.name }} home">
      {%- if settings.logo != blank -%}
        <img
          src="{{ settings.logo | image_url: width: 400 }}"
          alt="{{ shop.name }}"
          width="{{ settings.logo_width }}"
          height="{{ settings.logo_width | divided_by: settings.logo.aspect_ratio }}"
          style="width: {{ settings.logo_width }}px;"
          loading="eager"
          fetchpriority="high">
      {%- else -%}
        <img
          class="site-header__mark"
          src="{{ 'apex-mark.png' | asset_url }}"
          alt=""
          width="133"
          height="128"
          loading="eager"
          fetchpriority="high">
        <span class="site-header__wordmark">
          <span class="site-header__wordmark-line1">Apex</span>
          <span class="site-header__wordmark-line2">Charge Labs</span>
        </span>
      {%- endif -%}
    </a>

    <nav class="site-header__nav" aria-label="Primary">
      {%- for link in section.settings.menu.links -%}
        <a href="{{ link.url }}"{% if link.current %} aria-current="page"{% endif %}>{{ link.title }}</a>
      {%- endfor -%}
    </nav>

    <div class="site-header__actions">
      <a href="{{ routes.account_url }}" class="icon-btn" aria-label="Account">
        {% render 'icon', name: 'user' %}
      </a>
      <button class="icon-btn" type="button" data-cart-open aria-label="Open cart, {{ cart.item_count }} items">
        {% render 'icon', name: 'cart' %}
        <span class="cart-count{% if cart.item_count > 0 %} is-visible{% endif %}" data-cart-count>{{ cart.item_count }}</span>
      </button>
      {%- if section.settings.cta_label != blank -%}
        <a href="{{ section.settings.cta_url | default: '#purchase-apex' }}" class="btn btn--gold btn--header">{{ section.settings.cta_label }}</a>
      {%- endif -%}
    </div>
  </div>
</header>

<div class="mobile-nav" id="MobileNav" data-mobile-nav aria-hidden="true">
  <div class="mobile-nav__top">
    <span class="mono-tag">Menu</span>
    <button class="icon-btn" type="button" data-nav-close aria-label="Close menu" style="color: var(--color-text-on-dark);">
      {% render 'icon', name: 'close' %}
    </button>
  </div>
  <nav class="mobile-nav__list" aria-label="Mobile primary">
    {%- for link in section.settings.menu.links -%}
      <a href="{{ link.url }}">{{ link.title }}</a>
    {%- endfor -%}
    <a href="{{ routes.account_url }}">Account</a>
  </nav>
</div>

{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "Navigation menu",
      "default": "main-menu"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button label",
      "default": "Shop Apex"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "Button link"
    }
  ]
}
{% endschema %}
