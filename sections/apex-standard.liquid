<section class="section standard-strip-v2">
  <div class="wrap">
    <div class="standard-v2__head" data-animate>
      <span class="mono-tag">{{ section.settings.eyebrow }}</span>
      <h2 class="h-display standard-v2__heading">{{ section.settings.heading }}</h2>
    </div>

    <div class="standard-v2__list" data-animate-group>
      {%- for block in section.blocks -%}
        <div class="standard-v2__row" data-animate {{ block.shopify_attributes }}>
          <span class="standard-v2__no">{{ forloop.index | prepend: '0' }}</span>
          <span class="standard-v2__title">{{ block.settings.title }}</span>
          <span class="standard-v2__mark">{% render 'icon', name: 'cross' %}</span>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "The Apex Standard",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The Apex Standard" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "No Shortcuts. Only Standards." }
  ],
  "blocks": [
    {
      "type": "pillar",
      "name": "Pillar",
      "settings": [
        { "type": "text", "id": "title", "label": "Title" }
      ]
    }
  ],
  "presets": [
    {
      "name": "The Apex Standard",
      "blocks": [
        { "type": "pillar", "settings": { "title": "No Mystery Blends" } },
        { "type": "pillar", "settings": { "title": "No Made-Up Reviews" } },
        { "type": "pillar", "settings": { "title": "No Magic Claims" } },
        { "type": "pillar", "settings": { "title": "No Hidden Doses" } }
      ]
    }
  ]
}
{% endschema %}
