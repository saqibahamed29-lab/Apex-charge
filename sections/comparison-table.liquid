<section class="section section--dark" id="comparison">
  <div class="wrap">
    <div style="max-width: 640px; margin-bottom: 40px;" data-animate>
      <span class="eyebrow">Know before you compare</span>
      <h2 class="h-section">Apex vs. Red Bull vs. Neurogum</h2>
      <p class="lede" style="margin-top: 14px;">Apex's numbers come straight from our supplement facts panel. Competitor figures below are placeholders pending verification against their current published labels.</p>
    </div>

    <p class="compare-swipe-hint">Swipe to compare &rarr;</p>
    <div class="compare-table-wrap" data-animate>
      <table class="compare-table">
        <thead>
          <tr>
            <th scope="col">Per serving</th>
            <th scope="col" class="is-apex">Apex</th>
            <th scope="col">Red Bull</th>
            <th scope="col">Neurogum</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <th scope="row">Caffeine</th>
            <td class="is-apex">200mg</td>
            <td><span class="needs-verify">Needs verification</span></td>
            <td><span class="needs-verify">Needs verification</span></td>
          </tr>
          <tr>
            <th scope="row">L-Theanine</th>
            <td class="is-apex">100mg</td>
            <td><span class="needs-verify">Needs verification</span></td>
            <td><span class="needs-verify">Needs verification</span></td>
          </tr>
          <tr>
            <th scope="row">Sugar</th>
            <td class="is-apex">0g</td>
            <td><span class="needs-verify">Needs verification</span></td>
            <td><span class="needs-verify">Needs verification</span></td>
          </tr>
          <tr>
            <th scope="row">Calories</th>
            <td class="is-apex">20</td>
            <td><span class="needs-verify">Needs verification</span></td>
            <td><span class="needs-verify">Needs verification</span></td>
          </tr>
          <tr>
            <th scope="row">Serving</th>
            <td class="is-apex">2 Scoops (7g)</td>
            <td><span class="needs-verify">Needs verification</span></td>
            <td><span class="needs-verify">Needs verification</span></td>
          </tr>
          <tr>
            <th scope="row">Format</th>
            <td class="is-apex">Powder</td>
            <td><span class="needs-verify">Needs verification</span></td>
            <td><span class="needs-verify">Needs verification</span></td>
          </tr>
          <tr>
            <th scope="row">Ingredients</th>
            <td class="is-apex">Clearly disclosed</td>
            <td><span class="needs-verify">Needs verification</span></td>
            <td><span class="needs-verify">Needs verification</span></td>
          </tr>
          <tr>
            <th scope="row">Price / serving</th>
            <td class="is-apex">$3.45</td>
            <td><span class="needs-verify">Needs verification</span></td>
            <td><span class="needs-verify">Needs verification</span></td>
          </tr>
        </tbody>
      </table>
    </div>

    <p class="compare-note">Competitor data will be added once sourced and verified against current, published labels. <a href="#purchase-apex" class="btn--ghost" style="font-size: inherit;">Compare all three</a></p>
  </div>
</section>

{% schema %}
{
  "name": "Comparison table",
  "settings": [],
  "presets": [{ "name": "Comparison table" }]
}
{% endschema %}
