<section class="section section--dark final-cta">
  <div class="wrap" data-animate>
    <h2 class="h-display final-cta__title">{{ section.settings.heading }}</h2>
    <a href="{{ section.settings.cta_url | default: '#purchase-apex' }}" class="btn btn--gold">{{ section.settings.cta_label }}</a>
  </div>
</section>

{% schema %}
{
  "name": "Final CTA",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Know What You're Taking."
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button label",
      "default": "Shop Apex"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "Button link"
    }
  ],
  "presets": [{ "name": "Final CTA" }]
}
{% endschema %}
