<section class="section section--dark final-cta">
  <div class="wrap final-cta__inner" data-animate>
    <div class="final-cta__visual">
      {%- if section.settings.image != blank -%}
        {{ section.settings.image | image_url: width: 300 | image_tag: loading: 'lazy', alt: '' }}
      {%- else -%}
        <img src="{{ 'apex-product-label.png' | asset_url }}" alt="" width="1810" height="869" loading="lazy">
      {%- endif -%}
    </div>
    <h2 class="h-display final-cta__title">{{ section.settings.heading }}</h2>
    <a href="{{ section.settings.cta_url | default: '#purchase-apex' }}" class="btn btn--lime">{{ section.settings.cta_label }}</a>
  </div>
</section>

{% schema %}
{
  "name": "Final CTA",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Product image",
      "info": "Defaults to the label artwork. Replace with the real Shopify product image once available."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Know What You're Taking."
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button label",
      "default": "Shop Apex"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "Button link"
    }
  ],
  "presets": [{ "name": "Final CTA" }]
}
{% endschema %}
