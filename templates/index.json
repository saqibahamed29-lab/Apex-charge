        "q-2": { "type": "question", "settings": { "question": "Does Apex have sugar or artificial sweeteners?", "answer": "<p>Apex has 0g of sugar per serving. It's sweetened with sucralose and colored naturally with red beet juice powder.</p>" } },
        "q-3": { "type": "question", "settings": { "question": "What flavor is Apex, and how do I mix it?", "answer": "<p>Apex comes in Strawberry Shortcake. Mix 1 scoop with 6&ndash;10 fl oz of water, or to taste &mdash; use 2 scoops with double the water. Do not exceed 5 scoops in a 24-hour period.</p>" } },
        "q-4": { "type": "question", "settings": { "question": "Is Apex gluten-free and vegan?", "answer": "<p>Yes. Apex is gluten-free, sugar-free, and vegan-friendly, per the product label.</p>" } },
        "q-5": { "type": "question", "settings": { "question": "What allergens should I know about?", "answer": "<p>Apex is manufactured in a facility that also processes milk, eggs, fish, shellfish, tree nuts, peanuts, wheat, soybeans, and sesame.</p>" } },
        "q-6": { "type": "question", "settings": { "question": "Is Apex safe for daily use?", "answer": "<p>The label recommends no more than 5 scoops within a 24-hour period. If you're pregnant, nursing, have a medical condition, or take medication, consult your physician before use.</p>" } },
